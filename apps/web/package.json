{
  "name": "@torch/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_USE_MOCKS=1 vite",
    "build": "tsr generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "routes": "tsr generate",
    "test": "tsr generate && vitest",
    "e2e": "playwright test",
    "e2e:real": "E2E_TARGET=real playwright test --grep @demo",
    "lint": "tsr generate && eslint . --max-warnings 0",
    "typecheck": "tsr generate && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/eslint-plugin-query": "^5.78.0",
    "@tanstack/router-cli": "^1.120.0",
    "@tanstack/router-plugin": "^1.120.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.0",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "msw": { "workerDirectory": ["public"] }
}
