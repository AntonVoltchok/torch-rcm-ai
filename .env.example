# Torch demo configuration (copy to .env at the repo root; the API and the `torch` CLI load it, set variables win)
TORCH_AGENT_MODE=deterministic        # deterministic | live
ANTHROPIC_API_KEY=                     # required for live mode (unless replaying) and `torch cassette record`
TORCH_CASSETTE_MODE=off                # live only: off (call the API) | replay (canonical cassettes) | record
TORCH_MODEL_EXEC=claude-sonnet-5-5     # triage/planning (claims, followup)
TORCH_MODEL_DRAFT=claude-opus-5-5      # appeal / narrative drafting
TORCH_MODEL_FAST=claude-haiku-5-5      # eligibility parsing (scripted in demo; here for completeness)
TORCH_LIVE_CONCURRENCY=2
TORCH_RUN_COST_CAP_USD=0.25            # per-run cost cap; the run stops past it
TORCH_CLOCK_START=2026-10-28T10:40:00-04:00
TORCH_DB_URL=sqlite:///./torch.db
TORCH_SCENARIO=canonical
# TORCH_ALLOW_WORLD_ONLY=1             # boot the API even if torch_rcm.agents fails to import (default: refuse)
VITE_API_BASE=http://localhost:8000/api/v1
