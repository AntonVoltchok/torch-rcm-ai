# Torch demo configuration (copy to .env)
TORCH_AGENT_MODE=deterministic        # deterministic | live
ANTHROPIC_API_KEY=                     # required only for live mode
TORCH_MODEL_EXEC=claude-sonnet-5-5     # triage/planning (claims, followup)
TORCH_MODEL_DRAFT=claude-opus-5-5      # appeal / narrative drafting
TORCH_MODEL_CHEAP=claude-haiku-5-5     # eligibility parsing (scripted in demo; here for completeness)
TORCH_LIVE_CONCURRENCY=2
TORCH_LIVE_RUN_BUDGET_USD=0.25
TORCH_CLOCK_START=2026-10-28T10:40:00-04:00
TORCH_DB_URL=sqlite:///./torch.db
TORCH_SCENARIO=canonical
VITE_API_BASE=http://localhost:8000/api/v1
